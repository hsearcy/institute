# Copy to .env (repo root) and fill in what you need. The server loads it
# with `--env-file=../.env`. Every key is optional: without one, that
# feature turns off and the game still runs.

# Tutor LLM — generates word problems, hints and walkthroughs.
# Without it the server uses deterministic built-in problems.
ANTHROPIC_API_KEY=
# TUTOR_MODEL=claude-sonnet-5

# Spoken hints (ElevenLabs text-to-speech). Without it hints are text only.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Checks each spoken take against its text (Deepgram). Without it every take is kept.
DEEPGRAM_API_KEY=

# Asset tooling only (scripts/tripo). The game does not need it.
TRIPO_API_KEY=

# Server
# PORT=8787
# DB_PATH=data/institute.db
# PLAYER_TZ=America/New_York

# Suggestions. All secrets below are server-only. Never use a VITE_ prefix.
# Reuses DEEPGRAM_API_KEY above for raw audio transcription; text works without it.
# Parent API is disabled unless this independent high-entropy bearer token is set.
INSTITUTE_SUGGESTIONS_ADMIN_TOKEN=
# Comma-separated exact authenticated parent actor IDs supplied by the trusted bridge.
# Match the bridge's full actor string, including its discord: prefix.
INSTITUTE_SUGGESTIONS_PARENT_ACTORS=
# Canonical public origin behind an HTTPS proxy (scheme + host + optional port, no slash).
# Never trust arbitrary forwarded host/proto headers to establish this origin.
# INSTITUTE_SUGGESTIONS_PUBLIC_ORIGIN=https://institute.example

# Optional webhook transport. The Discord poll bridge does not need these.
# Without both, events remain queued until an authenticated readback acknowledgement.
INSTITUTE_SUGGESTIONS_WEBHOOK_URL=
INSTITUTE_SUGGESTIONS_WEBHOOK_SECRET=
