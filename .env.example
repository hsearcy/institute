# Copy to .env (repo root) and fill in what you need. The server loads it
# with `--env-file=../.env`. Every key is optional: without one, that
# feature turns off and the game still runs.

# Tutor LLM — generates word problems, hints and walkthroughs.
# Without it the server uses deterministic built-in problems.
ANTHROPIC_API_KEY=
# TUTOR_MODEL=claude-sonnet-5

# Spoken hints (ElevenLabs text-to-speech). Without it hints are text only.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Checks each spoken take against its text (Deepgram). Without it every take is kept.
DEEPGRAM_API_KEY=

# Asset tooling only (scripts/tripo). The game does not need it.
TRIPO_API_KEY=

# Server
# PORT=8787
# DB_PATH=data/institute.db
# PLAYER_TZ=America/New_York
