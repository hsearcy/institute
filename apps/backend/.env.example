# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is checked in as the canonical list.

# Anthropic API key for the Tutor Service LLM calls.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the default LLM model (default: claude-sonnet-4-6).
# TUTOR_MODEL=claude-sonnet-4-6

# Optional: shared bearer secret. When set, /tutor/next_round requires
# `Authorization: Bearer <this value>`. When unset (or empty), the endpoint
# is open — fine for local dev over Tailscale or LAN.
# Set the SAME value as EXPO_PUBLIC_TUTOR_SECRET on the kid-app side.
# TUTOR_SHARED_SECRET=
