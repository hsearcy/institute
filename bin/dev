#!/usr/bin/env bash
# Boot the full kid-app dev stack:
#   1. Rails backend (apps/backend) on :3000
#   2. kid-app Expo dev server on :8081 — both reachable over the tailnet at
#      the dev box's Tailscale address. No Expo `--tunnel` (ngrok) needed:
#      Metro's bundler is exposed directly to the phone via Tailscale.
#
# REACT_NATIVE_PACKAGER_HOSTNAME tells Metro to embed the tailscale hostname
# in the QR / dev URL so the phone connects to the right address.
#
# Ctrl-C cleans up everything.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BACKEND="$ROOT/apps/backend"
LOGDIR="$ROOT/tmp"
mkdir -p "$LOGDIR"
RAILS_LOG="$LOGDIR/rails.log"

# --- pre-flight ---
[[ -f "$BACKEND/.env" ]] || { echo "missing $BACKEND/.env (copy from .env.example)"; exit 1; }
# shellcheck disable=SC1090,SC1091
set -a; source "$BACKEND/.env"; set +a
[[ -n "${ANTHROPIC_API_KEY:-}" ]] || { echo "ANTHROPIC_API_KEY is empty in $BACKEND/.env"; exit 1; }
command -v tailscale >/dev/null || { echo "tailscale not found on PATH"; exit 1; }

# Resolve this machine's Tailscale v4 IP. We prefer the IP over the MagicDNS
# hostname because Android Expo Go doesn't always resolve `.ts.net` names
# through Tailscale's DNS — the IP is unconditional.
TUTOR_HOST="$(tailscale ip -4 2>/dev/null | head -n1 || true)"
if [[ -z "$TUTOR_HOST" ]]; then
  echo "tailscale appears not to be running or authenticated"
  exit 1
fi
TUTOR_URL="http://$TUTOR_HOST:3000"

PIDS=()
cleanup() {
  echo
  echo "[dev] shutting down…"
  for pid in "${PIDS[@]:-}"; do
    [[ -n "$pid" ]] && kill -TERM "$pid" 2>/dev/null || true
  done
  sleep 1
  for pid in "${PIDS[@]:-}"; do
    [[ -n "$pid" ]] && kill -KILL "$pid" 2>/dev/null || true
  done
}
trap cleanup EXIT INT TERM

# --- 1. rails backend ---
# Bail early if :3000 is already taken (stale rails server etc.) — much
# better than the script silently hanging while polling /up forever.
if ss -tln 2>/dev/null | grep -qE ':3000\s'; then
  echo "[dev] ERROR: port 3000 is already in use. Likely a stale Rails server."
  echo "[dev] To free it: pkill -f 'rails server' || pkill -f 'puma'"
  exit 1
fi

echo "[dev] starting Rails backend on :3000 (log: $RAILS_LOG)…"
( cd "$BACKEND" && RBENV_VERSION=3.4.7 bin/rails server -b 0.0.0.0 -p 3000 ) \
  > "$RAILS_LOG" 2>&1 &
RAILS_PID=$!
PIDS+=("$RAILS_PID")

# Wait for Rails to respond on /up. Bail loudly if the process died OR we
# never get a response — don't silently fall through to starting the kid-app.
RAILS_UP=0
for _ in {1..30}; do
  if ! kill -0 "$RAILS_PID" 2>/dev/null; then
    echo "[dev] ERROR: Rails server exited during boot. Tail of $RAILS_LOG:"
    tail -n 30 "$RAILS_LOG"
    exit 1
  fi
  if curl -fsS -o /dev/null http://127.0.0.1:3000/up 2>/dev/null; then
    echo "[dev] Rails is up."
    RAILS_UP=1
    break
  fi
  sleep 1
done

if [[ "$RAILS_UP" -ne 1 ]]; then
  echo "[dev] ERROR: Rails didn't respond on /up within 30s. Tail of $RAILS_LOG:"
  tail -n 30 "$RAILS_LOG"
  exit 1
fi

echo "[dev] backend reachable from your tailnet at: $TUTOR_URL"

# --- 2. kid-app ---
EXPO_VARS=( "EXPO_PUBLIC_TUTOR_BASE_URL=$TUTOR_URL" )
if [[ -n "${TUTOR_SHARED_SECRET:-}" ]]; then
  EXPO_VARS+=( "EXPO_PUBLIC_TUTOR_SECRET=$TUTOR_SHARED_SECRET" )
fi

EXPO_VARS+=( "REACT_NATIVE_PACKAGER_HOSTNAME=$TUTOR_HOST" )

echo "[dev] starting kid-app (Expo, LAN-over-tailnet at $TUTOR_HOST)…"
echo "[dev] env: ${EXPO_VARS[*]}"
echo "[dev] phone should be on the same tailnet; QR/URL will use $TUTOR_HOST"
echo

# No --tunnel: the phone reaches Metro at $TUTOR_HOST:8081 over Tailscale.
# `--clear` busts the Metro transform cache so source edits to deep modules
# (db.ts, persistence repos, etc.) reliably ship a fresh bundle to the phone.
env "${EXPO_VARS[@]}" pnpm --filter @institute/kid-app exec expo start --host=lan --clear
