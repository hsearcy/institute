#!/usr/bin/env bash
# Boot the full kid-app dev stack:
#   1. Rails backend (apps/backend) on :3000
#   2. kid-app Expo dev server with EXPO_PUBLIC_TUTOR_BASE_URL pointed at the
#      dev machine's Tailscale address (the phone reaches it over the tailnet,
#      no public tunnel needed for the backend).
#
# Expo's own `--tunnel` (ngrok via @expo/ngrok) is still used for the JS bundle
# delivery. Because we're NOT running a second ngrok agent for the backend,
# there's no free-tier "1 agent per account" conflict.
#
# Ctrl-C cleans up everything.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BACKEND="$ROOT/apps/backend"
LOGDIR="$ROOT/tmp"
mkdir -p "$LOGDIR"
RAILS_LOG="$LOGDIR/rails.log"

# --- pre-flight ---
[[ -f "$BACKEND/.env" ]] || { echo "missing $BACKEND/.env (copy from .env.example)"; exit 1; }
# shellcheck disable=SC1090,SC1091
set -a; source "$BACKEND/.env"; set +a
[[ -n "${ANTHROPIC_API_KEY:-}" ]] || { echo "ANTHROPIC_API_KEY is empty in $BACKEND/.env"; exit 1; }
command -v tailscale >/dev/null || { echo "tailscale not found on PATH"; exit 1; }

# Resolve this machine's Tailscale address. Prefer MagicDNS (stable, readable)
# but fall back to the v4 IP if MagicDNS isn't enabled / parsable.
TS_NAME="$(tailscale status --self --json 2>/dev/null | jq -r '.Self.DNSName // empty' | sed 's/\.$//')"
TS_IP="$(tailscale ip -4 2>/dev/null | head -n1 || true)"
if [[ -n "$TS_NAME" ]]; then
  TUTOR_HOST="$TS_NAME"
elif [[ -n "$TS_IP" ]]; then
  TUTOR_HOST="$TS_IP"
else
  echo "tailscale appears not to be running or authenticated"
  exit 1
fi
TUTOR_URL="http://$TUTOR_HOST:3000"

PIDS=()
cleanup() {
  echo
  echo "[dev] shutting down…"
  for pid in "${PIDS[@]:-}"; do
    [[ -n "$pid" ]] && kill -TERM "$pid" 2>/dev/null || true
  done
  sleep 1
  for pid in "${PIDS[@]:-}"; do
    [[ -n "$pid" ]] && kill -KILL "$pid" 2>/dev/null || true
  done
}
trap cleanup EXIT INT TERM

# --- 1. rails backend ---
echo "[dev] starting Rails backend on :3000 (log: $RAILS_LOG)…"
( cd "$BACKEND" && RBENV_VERSION=3.4.7 bin/rails server -b 0.0.0.0 -p 3000 ) \
  > "$RAILS_LOG" 2>&1 &
PIDS+=($!)

for _ in {1..30}; do
  if curl -fsS -o /dev/null http://127.0.0.1:3000/up 2>/dev/null; then
    echo "[dev] Rails is up."
    break
  fi
  sleep 1
done

echo "[dev] backend reachable from your tailnet at: $TUTOR_URL"

# --- 2. kid-app ---
EXPO_VARS=( "EXPO_PUBLIC_TUTOR_BASE_URL=$TUTOR_URL" )
if [[ -n "${TUTOR_SHARED_SECRET:-}" ]]; then
  EXPO_VARS+=( "EXPO_PUBLIC_TUTOR_SECRET=$TUTOR_SHARED_SECRET" )
fi

echo "[dev] starting kid-app (Expo, --tunnel)…"
echo "[dev] env: ${EXPO_VARS[*]}"
echo

env "${EXPO_VARS[@]}" pnpm --filter @institute/kid-app start --tunnel
